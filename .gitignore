# Environment / deployment state (never commit)
.env
infra/cdk.context.json
infra/deploy.config.json
security-scans/
local_only/

# Node
node_modules/
infra/cdk.out/
cdk.out/

# Compiled infra output
infra/*.js
infra/*.d.ts
infra/bin/*.js
infra/bin/*.d.ts
infra/lib/*.js
infra/lib/*.d.ts

# Python
__pycache__/
*.pyc
.venv/

# Build artifacts
dist/
build/

# OS
.DS_Store

# Vendored boto3 for the gateway provisioner Lambda (installed at deploy time;
# the runtime's bundled boto3 is too old for inference targets). See
# gateway/provisioner/requirements.txt.
gateway/provisioner/boto3*/
gateway/provisioner/botocore*/
gateway/provisioner/s3transfer*/
gateway/provisioner/jmespath*/
gateway/provisioner/dateutil*/
gateway/provisioner/python_dateutil*/
gateway/provisioner/urllib3*/
gateway/provisioner/six*
gateway/provisioner/bin/

# Vendored deps for the opt-in model-refresher Lambda (boto3>=1.43 + requests),
# installed at deploy time. See gateway/refresher/requirements.txt.
gateway/refresher/boto3*/
gateway/refresher/botocore*/
gateway/refresher/s3transfer*/
gateway/refresher/jmespath*/
gateway/refresher/dateutil*/
gateway/refresher/python_dateutil*/
gateway/refresher/urllib3*/
gateway/refresher/requests*/
gateway/refresher/charset_normalizer*/
gateway/refresher/idna*/
gateway/refresher/certifi*/
gateway/refresher/urllib3*
gateway/refresher/six*
gateway/refresher/bin/
gateway/refresher/__pycache__/
infra/cdk.out.baseline/
infra/cdk.out.g0off/
infra/cdk.out.g0on/
infra/cdk.out.*/

# Metering console build artifacts (deploy.sh builds at deploy time)
console/dist/
console/node_modules/
console/tsconfig.tsbuildinfo

# Local demo-seed manifest (scripts/seed-demo-metering-data.py writes it at runtime)
.demo-metering-manifest.json

# Local download cache for AWS Price List bulk offer files
# (scripts/fetch-bedrock-pricing.py --cache-dir)
.tmp-pricing/

# Generated operator/finance audit export (scripts/fetch-bedrock-pricing.py)
config/bedrock-pricing-catalog.csv

# Generated local security scan output
aws-security-scans/

# Kiro hook runtime state
.kiro/hooks/.state/

# Compiled Python native extensions
*.so
