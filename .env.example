# ============================================================
# Open WebUI on AWS with Amazon Bedrock — Environment Configuration
# ============================================================
# This is the single source of truth for all application config.
# Infrastructure values are auto-populated by deploy.sh.
# Secrets (OAUTH_CLIENT_SECRET, WEBUI_SECRET_KEY, DATABASE_PASSWORD)
# are injected from AWS Secrets Manager — never set them here.
# ============================================================

# ============================================================
# Application
# ============================================================
WEBUI_URL=https://oui.yourdomain.com
WEBUI_NAME=Open WebUI

# ============================================================
# Authentication — Cognito via built-in OIDC
# Auto-populated by deploy.sh from CDK stack outputs.
# ============================================================
ENABLE_OAUTH_SIGNUP=true
OAUTH_CLIENT_ID=your-cognito-client-id
# OAUTH_CLIENT_SECRET is injected from Secrets Manager
OPENID_PROVIDER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX/.well-known/openid-configuration
OAUTH_PROVIDER_NAME=Amazon Cognito
OAUTH_SCOPES=openid email profile
OPENID_REDIRECT_URI=https://oui.yourdomain.com/oauth/oidc/callback
ENABLE_OAUTH_PERSISTENT_CONFIG=false
OAUTH_USERNAME_CLAIM=email
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true

# Role mapping (Cognito groups → admin/user roles)
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=cognito:groups
OAUTH_ADMIN_ROLES=admin,webui-admins,admins
OAUTH_ALLOWED_ROLES=admin,webui-admins,admins,user,power-users,basic-users

# Group sync (Cognito groups → Open WebUI groups, used for model access control)
ENABLE_OAUTH_GROUP_MANAGEMENT=true
OAUTH_GROUP_CLAIM=cognito:groups
ENABLE_OAUTH_GROUP_CREATION=true

# Logout redirect
# WEBUI_AUTH_SIGNOUT_REDIRECT_URL is auto-populated by deploy.sh

# ============================================================
# Amazon Bedrock — via the AgentCore inference gateway
# ============================================================
# There are no Bedrock env vars to set here. Bedrock models are served through
# the AgentCore inference gateway (provisioned by the GatewayStack), which the
# deployment wires up automatically:
#   - GATEWAY_INFERENCE_URL and MANTLE_REGION are injected into the ECS task
#     from the GatewayStack output (see infra/lib/compute-stack.ts).
#   - Two OpenAI connections (Chat Completions + Responses) and the Claude pipe
#     are seeded into the app database at container start (pipe/seed.py).
# Each model call carries the logged-in user's own OAuth token to the gateway
# (per-user identity). See docs/GATEWAY_INTEGRATION_GUIDE.md.
#
# Which models appear is capability-filtered by the gateway interceptor from
# config/model-capabilities.json — Open WebUI only surfaces models that work.
#
# Model access is managed via Open WebUI's native RBAC: Cognito groups sync to
# Open WebUI groups (above); an admin sets model visibility per group in
# Workspace → Models. No custom env vars needed.
#
# Note: token quota enforcement is not included in this sample. For cost
# control, use Bedrock service quotas, CloudWatch Bedrock usage metrics, or
# application inference profiles for cost allocation.

# ============================================================
# WebSocket Support
# CloudFront supports WebSocket over VPC origins; the CDK stack pins this on
# and shares Socket.IO state across tasks via the Redis manager.
# ============================================================
ENABLE_WEBSOCKET_SUPPORT=true

# ============================================================
# Additional Providers (optional)
# ============================================================
# ENABLE_OPENAI_API=true
# OPENAI_API_BASE_URLS=https://api.openai.com/v1
# OPENAI_API_KEYS=sk-xxx

# ============================================================
# Open WebUI Image Version (consumed by deploy.sh, not the app)
# ============================================================
# Which Open WebUI version to deploy. Leave UNSET (the default) to deploy the
# latest official Open WebUI release: deploy.sh discovers the newest release
# tag and resolves it to an immutable @sha256 digest at deploy time
# (scripts/resolve-owui-image.py), so the task definition never floats.
#
# To pin a specific version, set a release tag (resolved to its digest at
# deploy time) or a full digest (used verbatim, works offline):
#   OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
#   OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:72c0ba641ba75e...
#
# Record the digest that each deploy prints ("Open WebUI image: …") — setting
# it here is also the rollback path (see docs/UPGRADE_RUNBOOK.md).
# Avoid :latest — on ghcr it is upstream's main-branch build, not a release.
#OPEN_WEBUI_IMAGE=

# ============================================================
# Opt-in deploy features (consumed by deploy.sh, not the app)
# ============================================================
# Scheduled model-capability refresher Lambda (re-probes bedrock-mantle and
# refreshes the interceptor's model list). Default off. Setting this true both
# vendors its deps and passes -c enableModelRefresh=true to the CDK deploy.
# ENABLE_MODEL_REFRESH=true
# MODEL_REFRESH_RATE_HOURS=24
